-- ============================================================
-- AUTO BAT LOGIC
-- ============================================================
local autoBatConnection = nil
local batEnabled = false

local function enableAutoBat()
    autoBatConnection = RunService.RenderStepped:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local bat = LocalPlayer.Backpack:FindFirstChild("Bat")
        if bat then humanoid:EquipTool(bat) end
        local equippedBat = character:FindFirstChild("Bat")
        if equippedBat then equippedBat:Activate() end
    end)
end

local function disableAutoBat()
    if autoBatConnection then
        autoBatConnection:Disconnect()
        autoBatConnection = nil
    end
end

local function setBatEnabled(v)
    batEnabled = v
    if v then
        status.Text = "Bat: Active"
        status.TextColor3 = GREEN
        tw(track, fast, {BackgroundColor3 = ACCENT})
        tw(knob, fast, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = WHITE})
        tw(label, fast, {TextColor3 = WHITE})
        tw(toggleStroke, fast, {Transparency = 0.2})
        tw(mainStroke, fast, {Transparency = 0.1})
        dot.BackgroundColor3 = GREEN
        enableAutoBat()
    else
        status.Text = "Status: Off"
        status.TextColor3 = MUTED
        tw(track, fast, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        tw(knob, fast, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = MUTED})
        tw(label, fast, {TextColor3 = MUTED})
        tw(toggleStroke, fast, {Transparency = 0.7})
        tw(mainStroke, fast, {Transparency = 0.4})
        dot.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        disableAutoBat()
    end
end

click.MouseButton1Click:Connect(function()
    setBatEnabled(not batEnabled)
end)

-- ============================================================
-- BODY TRACE LOGIC
-- ============================================================
local bodyTraceEnabled = false
local bodyTraceConn = nil
local lookAttach = nil
local lookAlign = nil

local function getNearestPlayer()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local nearest, dist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local otherHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = p.Character:FindFirstChildOfClass("Humanoid")
            if otherHRP and otherHum and otherHum.Health > 0 then
                local d = (otherHRP.Position - hrp.Position).Magnitude
                if d < dist then
                    nearest = otherHRP
                    dist = d
                end
            end
        end
    end
    return nearest
end

local function enableBodyTrace()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    hum.AutoRotate = false

    lookAttach = Instance.new("Attachment")
    lookAttach.Parent = hrp

    lookAlign = Instance.new("AlignOrientation")
    lookAlign.Attachment0 = lookAttach
    lookAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
    lookAlign.RigidityEnabled = true
    lookAlign.MaxTorque = math.huge
    lookAlign.Responsiveness = 200
    lookAlign.Parent = hrp

    bodyTraceConn = RunService.RenderStepped:Connect(function()
        if not bodyTraceEnabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        local target = getNearestPlayer()
        if not target then
            if lookAlign then lookAlign.Enabled = false end
            return
        end
        local lookPos = Vector3.new(target.Position.X, r.Position.Y, target.Position.Z)
        if lookAlign then
            lookAlign.Enabled = true
            lookAlign.CFrame = CFrame.lookAt(r.Position, lookPos)
        end
    end)
end

local function disableBodyTrace()
    if bodyTraceConn then
        bodyTraceConn:Disconnect()
        bodyTraceConn = nil
    end
    if lookAlign then lookAlign:Destroy(); lookAlign = nil end
    if lookAttach then lookAttach:Destroy(); lookAttach = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    end
end

local function setTrackEnabled(v)
    bodyTraceEnabled = v
    if v then
        tw(trackTrack, fast, {BackgroundColor3 = ACCENT})
        tw(trackKnob, fast, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = WHITE})
        tw(trackLabel, fast, {TextColor3 = WHITE})
        tw(trackStroke, fast, {Transparency = 0.2})
        status.Text = "Tracing..."
        status.TextColor3 = ACCENT
        enableBodyTrace()
    else
        tw(trackTrack, fast, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        tw(trackKnob, fast, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = MUTED})
        tw(trackLabel, fast, {TextColor3 = MUTED})
        tw(trackStroke, fast, {Transparency = 0.7})
        if not batEnabled then
            status.Text = "Status: Off"
            status.TextColor3 = MUTED
        end
        disableBodyTrace()
    end
end

trackClick.MouseButton1Click:Connect(function()
    setTrackEnabled(not bodyTraceEnabled)
end)

LocalPlayer.CharacterAdded:Connect(function()
    if bodyTraceEnabled then
        task.wait(0.5)
        disableBodyTrace()
        enableBodyTrace()
    end
end)

task.spawn(function()
    while true do
        tw(mainStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = batEnabled and 0.05 or 0.55})
        task.wait(1.5)
        tw(mainStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = batEnabled and 0.3 or 0.7})
        task.wait(1.5)
    end
end)
