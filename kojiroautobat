local function setBatEnabled(v)
    autoBatEnabled = v
    if v then
        status.Text = "Bat: Active"
        status.TextColor3 = GREEN
        tw(track, fast, {BackgroundColor3 = ACCENT})
        tw(knob, fast, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = WHITE})
        tw(label, fast, {TextColor3 = WHITE})
        tw(toggleStroke, fast, {Transparency = 0.2})
        tw(mainStroke, fast, {Transparency = 0.1})
        dot.BackgroundColor3 = GREEN
    else
        status.Text = "Status: Off"
        status.TextColor3 = MUTED
        tw(track, fast, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        tw(knob, fast, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = MUTED})
        tw(label, fast, {TextColor3 = MUTED})
        tw(toggleStroke, fast, {Transparency = 0.7})
        tw(mainStroke, fast, {Transparency = 0.4})
        dot.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    end
end

local function setTrackEnabled(v)
    bodyTraceEnabled = v
    if v then
        tw(trackTrack, fast, {BackgroundColor3 = ACCENT})
        tw(trackKnob, fast, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = WHITE})
        tw(trackLabel, fast, {TextColor3 = WHITE})
        tw(trackStroke, fast, {Transparency = 0.2})
        status.Text = "Tracing..."
        status.TextColor3 = ACCENT
        enableBodyTrace()
    else
        tw(trackTrack, fast, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        tw(trackKnob, fast, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = MUTED})
        tw(trackLabel, fast, {TextColor3 = MUTED})
        tw(trackStroke, fast, {Transparency = 0.7})
        if not autoBatEnabled then
            status.Text = "Status: Off"
            status.TextColor3 = MUTED
        end
        disableBodyTrace()
    end
end

click.MouseButton1Click:Connect(function()
    setBatEnabled(not autoBatEnabled)
end)

trackClick.MouseButton1Click:Connect(function()
