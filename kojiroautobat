-- Bat
local hittingCooldown = false
local function getBat()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChild("Bat")
    if tool then
        return tool
    end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        tool = backpack:FindFirstChild("Bat")
        if tool then
            tool.Parent = char
            return tool
        end
    end
end
local function tryHitBat()
    if hittingCooldown then return end
    hittingCooldown = true
    pcall(function()
        local bat = getBat()
        if bat then
            bat:Activate()
            local remote = bat:FindFirstChildWhichIsA("RemoteEvent")
            if remote then
                remote:FireServer()
            end
        end
    end)
    task.delay(0.08, function()
        hittingCooldown = false
    end)
end
local function getClosestPlayer()
    if not hrp then return nil, math.huge end
    local closest
    local distance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local enemyHRP = player.Character:FindFirstChild("HumanoidRootPart")
            local enemyHum = player.Character:FindFirstChild("Humanoid")
            if enemyHRP and enemyHum and enemyHum.Health > 0 then
                local dist = (hrp.Position - enemyHRP.Position).Magnitude
                if dist < distance then
                    distance = dist
                    closest = player
                end
            end
        end
    end
    return closest, distance
end
-- Body trace FIXED
local RunService = game:GetService("RunService")

local bodyTraceEnabled = false
local bodyTraceConn

local SMOOTH_SPEED = 6

local function getClosestPlayer()
    if not hrp then return nil end

    local closest
    local dist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")

            if root and hum and hum.Health > 0 then
                local d = (hrp.Position - root.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = root
                end
            end
        end
    end

    return closest
end

local function disableBodyTrace()
    if bodyTraceConn then
        bodyTraceConn:Disconnect()
        bodyTraceConn = nil
    end

    if hum then
        hum.AutoRotate = true
    end
end

local function enableBodyTrace()
    disableBodyTrace()

    if not hrp or not hum then return end

    hum.AutoRotate = false

    bodyTraceConn = RunService.RenderStepped:Connect(function(dt)
        if not bodyTraceEnabled then return end

        local target = getClosestPlayer()
        if not target then return end

        -- flat look (no tilt)
        local targetPos = Vector3.new(
            target.Position.X,
            hrp.Position.Y,
            target.Position.Z
        )

        local goal = CFrame.lookAt(hrp.Position, targetPos)

        -- smooth, frame-rate independent interpolation
        local alpha = 1 - math.exp(-SMOOTH_SPEED * dt)

        local newCF = hrp.CFrame:Lerp(goal, alpha)

        -- IMPORTANT: lock position so it never drifts
        hrp.CFrame = CFrame.new(hrp.Position) * (newCF - newCF.Position)
    end)
end
-- States
local autoBatEnabled = false
local function setToggle(ui, enabled)
    if enabled then
        tw(ui.Track, fast, {
            BackgroundColor3 = ACCENT
        })
        tw(ui.Knob, fast, {
            Position = UDim2.new(1,-17,0.5,-7),
            BackgroundColor3 = WHITE
        })
        tw(ui.Label, fast, {
            TextColor3 = WHITE
        })
        tw(ui.Stroke, fast, {
            Transparency = 0.2
        })
    else
        tw(ui.Track, fast, {
            BackgroundColor3 = Color3.fromRGB(30,30,50)
        })
        tw(ui.Knob, fast, {
            Position = UDim2.new(0,3,0.5,-7),
            BackgroundColor3 = MUTED
        })
        tw(ui.Label, fast, {
            TextColor3 = MUTED
        })
        tw(ui.Stroke, fast, {
            Transparency = 0.7
        })
    end
end
local function setBatEnabled(state)
    autoBatEnabled = state
    setToggle(autoUI, state)
    if state then
        status.Text = "Auto Bat: ON"
        status.TextColor3 = GREEN
        dot.BackgroundColor3 = GREEN
    else
        status.Text = "Auto Bat: OFF"
        status.TextColor3 = MUTED
        dot.BackgroundColor3 = Color3.fromRGB(60,60,80)
    end
end
local function setTraceEnabled(state)
    bodyTraceEnabled = state
    setToggle(traceUI, state)
    if state then
        status.Text = "Body Trace: ON"
        status.TextColor3 = ACCENT
        enableBodyTrace()
    else
        disableBodyTrace()
        if autoBatEnabled then
            status.Text = "Auto Bat: ON"
            status.TextColor3 = GREEN
        else
            status.Text = "Status: OFF"
            status.TextColor3 = MUTED
        end
    end
end
-- Toggle clicks
autoUI.Button.MouseButton1Click:Connect(function()
