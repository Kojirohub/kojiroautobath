-- ============================================================
-- AUTO BAT LOGIC
-- ============================================================
local autoBatConnection = nil
local batEnabled = false

local function isPlayerNearby()
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local otherHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = p.Character:FindFirstChildOfClass("Humanoid")
            if otherHRP and otherHum and otherHum.Health > 0 then
                if (otherHRP.Position - hrp.Position).Magnitude <= DETECT_RANGE then
                    return true
                end
            end
        end
    end
    return false
end

local function enableAutoBat()
    autoBatConnection = RunService.RenderStepped:Connect(function()
        if not isPlayerNearby() then
            status.Text = "Waiting..."
            status.TextColor3 = MUTED
            return
        end
        status.Text = "Swinging!"
        status.TextColor3 = ACCENT
        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local bat = LocalPlayer.Backpack:FindFirstChild("Bat")
        if bat then humanoid:EquipTool(bat) end
        local equippedBat = character:FindFirstChild("Bat")
        if equippedBat then equippedBat:Activate() end
    end)
end

local function disableAutoBat()
    if autoBatConnection then
        autoBatConnection:Disconnect()
        autoBatConnection = nil
    end
end

local function setBatEnabled(v)
    batEnabled = v
    if v then
        status.Text = "Waiting..."
        status.TextColor3 = MUTED
        tw(track, fast, {BackgroundColor3 = ACCENT})
        tw(knob, fast, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = WHITE})
        tw(label, fast, {TextColor3 = WHITE})
        tw(toggleStroke, fast, {Transparency = 0.2})
        tw(mainStroke, fast, {Transparency = 0.1})
        dot.BackgroundColor3 = GREEN
        enableAutoBat()
    else
        status.Text = "Status: Off"
        status.TextColor3 = MUTED
        tw(track, fast, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        tw(knob, fast, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = MUTED})
        tw(label, fast, {TextColor3 = MUTED})
        tw(toggleStroke, fast, {Transparency = 0.7})
        tw(mainStroke, fast, {Transparency = 0.4})
        dot.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        disableAutoBat()
    end
end

click.MouseButton1Click:Connect(function()
    setBatEnabled(not batEnabled)
end)

-- ============================================================
-- SPIN CAMERA LOGIC
-- ============================================================
local spinEnabled = false
local spinConnection = nil
local spinAngle = 0
local SPIN_SPEED = 1.2 -- mid pace

local function enableSpin()
    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Scriptable
    spinConnection = RunService.RenderStepped:Connect(function(dt)
        if not spinEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        spinAngle = spinAngle + SPIN_SPEED * dt
        local radius = 12
        local height = hrp.Position.Y + 5
        local x = hrp.Position.X + math.cos(spinAngle) * radius
        local z = hrp.Position.Z + math.sin(spinAngle) * radius
        camera.CFrame = CFrame.new(Vector3.new(x, height, z), hrp.Position)
    end)
end

local function disableSpin()
    if spinConnection then
        spinConnection:Disconnect()
        spinConnection = nil
    end
    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Custom
    spinAngle = 0
end

local function setSpinEnabled(v)
    spinEnabled = v
    if v then
        tw(spinTrack, fast, {BackgroundColor3 = ACCENT})
        tw(spinKnob, fast, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = WHITE})
        tw(spinLabel, fast, {TextColor3 = WHITE})
        tw(spinStroke, fast, {Transparency = 0.2})
        enableSpin()
    else
        tw(spinTrack, fast, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        tw(spinKnob, fast, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = MUTED})
        tw(spinLabel, fast, {TextColor3 = MUTED})
        tw(spinStroke, fast, {Transparency = 0.7})
        disableSpin()
    end
end

spinClick.MouseButton1Click:Connect(function()
    setSpinEnabled(not spinEnabled)
end)

-- glow pulse
task.spawn(function()
    while true do
        tw(mainStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = batEnabled and 0.05 or 0.55})
        task.wait(1.5)
        tw(mainStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = batEnabled and 0.3 or 0.7})
        task.wait(1.5)
    end
end)
